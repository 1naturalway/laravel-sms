{
    "name": "1naturalway/laravel-sms",
    "description": "A driver-based SMS abstraction layer for Laravel, following the MailManager pattern.",
    "license": "MIT",
    "type": "library",
    "keywords": ["laravel", "sms", "twilio", "messaging"],
    "authors": [
      {
        "name": "Andrew Donald Johnson",
        "email": "ajohnson6494@gmail.com"
      }
    ],
    "require": {
        "php": "^8.4 || ^8.5",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "mockery/mockery": "^1.4.4",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^4.0",
        "twilio/sdk": "^8.11"
    },
    "suggest": {
        "twilio/sdk": "Required to use the Twilio SMS driver (^8.0)."
    },
    "autoload": {
        "psr-4": {
            "OneNaturalWay\\Sms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OneNaturalWay\\Sms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OneNaturalWay\\Sms\\SmsServiceProvider"
            ],
            "aliases": {
                "Sms": "OneNaturalWay\\Sms\\Facades\\Sms"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
